# =============================================================
# RAIZIAN PORTFOLIO — ENVIRONMENT VARIABLES
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to Git.
# =============================================================

# --- SMTP Configuration ---
# Host for your email provider's SMTP server.
# Gmail: smtp.gmail.com
# Outlook/Hotmail: smtp-mail.outlook.com
# Zoho: smtp.zoho.in
# Your custom domain (e.g., via Hostinger): smtp.hostinger.com
SMTP_HOST=smtp.gmail.com

# SMTP Port:
#   465 → SSL (set SMTP_SECURE=true)
#   587 → TLS/STARTTLS (set SMTP_SECURE=false)
SMTP_PORT=587

# Set to true if using port 465 (SSL), false for port 587 (TLS)
SMTP_SECURE=false

# Your SMTP login email (the email address you send FROM)
SMTP_USER=your-email@gmail.com

# Your SMTP password or App Password
# If using Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_PASS=your-google-app-password

# The email address that should RECEIVE the contact form submissions
SMTP_TO=your-email@gmail.com

# --- Server Config ---
# Port for the Express email server (default: 3001)
SMTP_PORT_SERVER=3001

# The URL of your frontend (for CORS)
FRONTEND_URL=http://localhost:3000
